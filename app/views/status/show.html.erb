<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ACME Salary Management API</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f6f7fb;
      --card: #ffffff;
      --text: #1a1f36;
      --muted: #5b6478;
      --ok: #0f7b3c;
      --bad: #b42318;
      --line: #d8dee9;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f1419;
        --card: #171c24;
        --text: #eef2f7;
        --muted: #9aa4b2;
        --line: #2a3340;
      }
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
      display: grid;
      place-items: center;
      padding: 1.5rem;
    }

    main {
      width: min(100%, 32rem);
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }

    h1 {
      margin: 0 0 0.25rem;
      font-size: 1.35rem;
    }

    p {
      margin: 0;
      color: var(--muted);
      line-height: 1.5;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin: 1rem 0 1.25rem;
      padding: 0.45rem 0.75rem;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      background: #eef2ff;
      color: #3730a3;
    }

    .badge.ok { background: #e7f6ec; color: var(--ok); }
    .badge.bad { background: #fdecec; color: var(--bad); }
    .badge.pending { background: #f3f4f6; color: var(--muted); }

    .dot {
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 50%;
      background: currentColor;
    }

    dl {
      margin: 0;
      display: grid;
      gap: 0.75rem;
    }

    .row {
      display: grid;
      gap: 0.15rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--line);
    }

    dt {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
    }

    dd {
      margin: 0;
      font-size: 0.95rem;
      word-break: break-word;
    }

    a { color: inherit; }
  </style>
</head>
<body>
  <main>
    <h1>ACME Salary Management API</h1>
    <p>Rails JSON backend for employee salary data and compensation insights.</p>

    <div id="status-badge" class="badge pending">
      <span class="dot"></span>
      <span id="status-text">Checking server…</span>
    </div>

    <dl>
      <div class="row">
        <dt>Health check</dt>
        <dd><a href="/up">/up</a> — <span id="health-detail">pending</span></dd>
      </div>
    </dl>
  </main>

  <script>
    const badge = document.getElementById("status-badge");
    const statusText = document.getElementById("status-text");
    const healthDetail = document.getElementById("health-detail");

    async function checkHealth() {
      try {
        const response = await fetch("/up", { headers: { Accept: "text/html" } });
        if (!response.ok) throw new Error("HTTP " + response.status);
        badge.className = "badge ok";
        statusText.textContent = "Server is up";
        healthDetail.textContent = "200 OK";
      } catch (error) {
        badge.className = "badge bad";
        statusText.textContent = "Server unreachable";
        healthDetail.textContent = error.message;
      }
    }

    checkHealth();
  </script>
</body>
</html>
